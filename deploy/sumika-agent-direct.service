[Unit]
Description=Sumika QQ Agent direct Python service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/opt/sumika
EnvironmentFile=/opt/sumika/deploy/.env
ExecStart=/opt/sumika/.venv/bin/python -m uvicorn sumika_agent.app:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
