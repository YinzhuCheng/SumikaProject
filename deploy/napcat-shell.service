[Unit]
Description=NapCatQQ shell service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/opt/napcat
EnvironmentFile=-/etc/sumika/napcat.env
ExecStart=/usr/bin/env xvfb-run -a ${NAPCAT_QQ_BIN} --no-sandbox -q ${SUMIKA_QQ_UIN}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
